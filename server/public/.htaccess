# Copied into client/dist. Unused when texturedlab.org is attached to the Node app.
# SPA fallback only — do not proxy to *.hostingersite.com.
# Split-host proxy example: docs/htaccess-api-proxy.example

ErrorDocument 404 /index.html

AddType application/javascript .mjs
AddType text/javascript .mjs

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|tl-sw\.js|tl-sw-.*\.js|sw\.js|registerSW\.js|manifest\.json|pwa-reset\.html|workbox-.*\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set CDN-Cache-Control "no-store"
    Header set Surrogate-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]
  RewriteRule ^pwa-reset\.html$ - [L]
  RewriteRule ^api(/|$) - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule . /index.html [L]
</IfModule>
