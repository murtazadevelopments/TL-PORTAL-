PORT=5001

# Supabase Postgres (transaction pooler recommended)
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT signing secret (long random string)
JWT_SECRET=replace_with_long_random_secret

# Supabase Storage (server-side)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Comma-separated frontend origins (no trailing slashes)
ALLOWED_ORIGINS=https://texturedlab.org,https://www.texturedlab.org,https://portal.texturedlab.com,https://www.portal.texturedlab.com,https://seagreen-weasel-875788.hostingersite.com,http://localhost:5173

# Resend (password reset, username reminder, signup/update notifications)
RESEND_API_KEY=re_xxxxxxxx
# Use a verified domain sender once DNS is verified in Resend, e.g.:
# RESEND_FROM=Portal TL <noreply@texturedlab.org>
# Until then, onboarding@resend.dev can ONLY email the Resend account owner.
RESEND_FROM=Portal TL <noreply@texturedlab.org>
# Frontend origin used in password-reset email links
FRONTEND_URL=http://localhost:5173
# Optional extra admin recipients (comma-separated); DB role=admin emails are always included
ADMIN_NOTIFY_EMAILS=

# Timezone for birthday cron + email timestamps (Hostinger often UTC without this)
APP_TIMEZONE=Asia/Karachi
# Daily birthday job (default 08:00). Requires Node process to stay running.
BIRTHDAY_CRON=0 8 * * *
