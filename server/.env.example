PORT=5001

# Supabase Postgres (transaction pooler recommended)
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT signing secret (long random string)
JWT_SECRET=replace_with_long_random_secret

# Supabase Storage (used only for one-time migration script; new uploads go to disk)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Private file uploads on Hostinger (MUST be outside public_html AND outside the Node app folder)
# Example: /home/uXXXXXX/private_uploads
# If unset, defaults to server/private_uploads (wiped on many Hostinger redeploys — set this in production!)
UPLOAD_ROOT=

# Comma-separated frontend origins (no trailing slashes)
ALLOWED_ORIGINS=https://texturedlab.org,https://www.texturedlab.org,http://localhost:5173

# SMTP — Brevo (smtp-relay.brevo.com). MAIL_FROM must match the verified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
MAIL_FROM=Textured Lab Portal <noreply@texturedlab.org>
MAIL_DAILY_WARN=250
# SMTP_REPLY_TO=support@texturedlab.org
# Frontend origin used in password-reset email links (public site URL).
# Local email testing with Vite: set ALLOW_LOCAL_RESET_LINKS=1 and FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://texturedlab.org
# WebAuthn / passkeys (Face ID, fingerprint). RP ID must match the site hostname.
WEBAUTHN_RP_ID=texturedlab.org
WEBAUTHN_RP_NAME=Textured Lab Portal
# Optional comma-separated allowed origins (defaults include texturedlab.org + localhost)
# WEBAUTHN_ORIGIN=https://texturedlab.org,http://localhost:5173
# Optional extra admin recipients (comma-separated); DB role=admin emails are always included
ADMIN_NOTIFY_EMAILS=

# Timezone for birthday cron + email timestamps (Hostinger often UTC without this)
APP_TIMEZONE=Asia/Karachi
# Daily birthday job (default 08:00). Requires Node process to stay running.
BIRTHDAY_CRON=0 8 * * *
# Weekly login_logs prune (default Sunday 03:00). Keeps last 12 months only.
LOGIN_LOGS_PRUNE_CRON=0 3 * * 0

# Protect GET /api/health/db-check?secret=... (hostname + SELECT 1 probe; no password leaked)
HEALTH_CHECK_SECRET=replace_with_long_random_string

# Web Push (mobile installed PWA notifications). Generate with:
#   npx web-push generate-vapid-keys
# Subject must be mailto: or https: URL identifying your app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@texturedlab.org

# Unified Node app serves client/dist + /api. Leave API_ONLY unset.
# API_ONLY=true

# Remote attendance (face check-in). Hours are in APP_TIMEZONE (Asia/Karachi).
FACE_MATCH_THRESHOLD=0.55
ATTENDANCE_SHIFT_START=9
ATTENDANCE_SHIFT_END=18
ATTENDANCE_GRACE_MINUTES=10
ATTENDANCE_MISSED_CRON=* * * * *

# ZKTeco biometric device (run `node scripts/sync.js` on the OFFICE LAN, not Hostinger)
# Device logs are stored in `zkteco_attendance_logs` (not face-checkin `attendance_logs`).
ZKTECO_IP=192.168.1.201
ZKTECO_PORT=4370
ZKTECO_SYNC_INTERVAL_MS=300000
# Set true only on a machine that can reach the device
ZKTECO_SYNC_ENABLED=false
# Service role key for sync.js upserts (same as SUPABASE_SECRET_KEY)
# SUPABASE_SERVICE_ROLE_KEY=

