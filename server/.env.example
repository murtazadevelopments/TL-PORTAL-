PORT=5001

# Supabase Postgres (transaction pooler recommended)
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT signing secret (long random string)
JWT_SECRET=replace_with_long_random_secret

# Supabase Storage (server-side)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Comma-separated frontend origins allowed to call this API (no trailing slashes)
# Add every place the React app is served from (custom domain + Hostinger subdomain + local Vite)
ALLOWED_ORIGINS=https://portal.texturedlab.com,https://www.portal.texturedlab.com,https://mediumpurple-chicken-145151.hostingersite.com,http://localhost:5173
